{
  "name": "clio-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "clean": "rm -rf coverage && rm -rf dist",
    "dist": "ng build --progress=false --configuration production",
    "lint": "eslint src/app --fix",
    "watch": "ng build --watch --configuration development",
    "test:dev": "jest --collect-coverage",
    "prep-test-data": "node tools/rename-files-to-mjs.mjs ./out-tsc",
    "start:ci-data": "tsc --project tsconfig.test-data.json && npm run prep-test-data && (node --experimental-specifier-resolution=node --use_strict ./out-tsc/app/test-data/index.mjs)",
    "prettier": "prettier --write 'src/**/*.{ts,js,json,scss,html}' '*.{scss,js,json}'",
    "prettier:ci": "prettier --list-different 'src/**/*.{ts,js,json,scss,html}' '*.{js,json}'"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.1.3",
    "@angular/common": "^19.1.3",
    "@angular/compiler": "^19.1.3",
    "@angular/core": "^19.1.3",
    "@angular/forms": "^19.1.3",
    "@angular/platform-browser": "^19.1.3",
    "@angular/platform-browser-dynamic": "^19.1.3",
    "@angular/router": "^19.1.3",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "eslint": "^9.20.1",
    "prettier": "^3.7.3",
    "rxjs": "^7.5.5",
    "tslib": "^2.3.0",
    "typescript-eslint": "^8.48.1",
    "zone.js": "^0.15.0"
  },
  "engines": {
    "node": ">= v18.10.0",
    "npm": ">=10.1.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.1.4",
    "@angular/cli": "^19.1.4",
    "@angular/compiler-cli": "^19.1.3",
    "@eslint/eslintrc": "^3.2.0",
    "@types/jest": "^30.0.0",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.6.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
