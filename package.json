{
  "name": "clio-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "clean": "rm -rf ./out-tsc && rm -rf test-data/src-copy && rm -rf .angular && rm -rf coverage && rm -rf dist",
    "dist": "ng build --progress=false --configuration production",
    "lint": "eslint src/app --fix",
    "lint:ci": "eslint src/app",
    "watch": "ng build --watch --configuration development",
    "test:dev": "jest --collect-coverage",
    "cypress": "cypress open",
    "cypress:ci": "run-p --race start:ci cypress:run",
    "cypress:run": "sleep 10 && cypress run --browser chrome --config '{\"component\": {},  \"e2e\": { \"excludeSpecPattern\": \"**/**a11y.cy.ts\"}}'",
    "test:e2e": "npm run prep-test-data && tsc --project tsconfig.test-data.json && ((node --use_strict ./out-tsc/test-data/index.mjs) & (npm run cypress:ci) ; fuser -k 3001/tcp)",
    "prep-test-data": "npm run clean && node tools/copy-source-files-to-ci.mjs ./",
    "start:ci": "ng serve --port 4280 --live-reload=false --configuration=e2e",
    "start:ci-data": "npm run prep-test-data && tsc --project tsconfig.test-data.json && (node --use_strict ./out-tsc/test-data/index.mjs)",
    "prettier": "prettier --write 'src/**/*.{ts,js,json,scss,html}' '*.{scss,js,json}'",
    "prettier:ci": "prettier --list-different 'src/**/*.{ts,js,json,scss,html}' '*.{js,json}'"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.18",
    "@angular/common": "^20.3.18",
    "@angular/compiler": "^20.3.18",
    "@angular/core": "^20.3.18",
    "@angular/forms": "^20.3.18",
    "@angular/platform-browser": "^20.3.18",
    "@angular/platform-browser-dynamic": "^20.3.18",
    "@angular/router": "^20.3.18",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "eslint": "^9.20.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.7.3",
    "rxjs": "^7.5.5",
    "tslib": "^2.3.0",
    "typescript-eslint": "^8.48.1",
    "zone.js": "^0.15.0"
  },
  "engines": {
    "node": ">= v18.10.0",
    "npm": ">=10.1.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.22",
    "@angular/cli": "^20.3.22",
    "@angular/compiler-cli": "^20.3.18",
    "@eslint/eslintrc": "^3.2.0",
    "@types/jest": "^30.0.0",
    "cypress": "^14.0.1",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.6.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
